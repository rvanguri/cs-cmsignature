# Git LFS: track large derived data tables so they don't bloat the git history.
# Small tables tracked by LFS too is harmless (keeps rules simple).
*.tsv    filter=lfs diff=lfs merge=lfs -text
*.tsv.gz filter=lfs diff=lfs merge=lfs -text
*.csv    filter=lfs diff=lfs merge=lfs -text
*.pdf    filter=lfs diff=lfs merge=lfs -text

# Keep these small text files OUT of LFS (normal git):
metadata/*.tsv       -filter -diff -merge text
*.TEMPLATE.tsv       -filter -diff -merge text
