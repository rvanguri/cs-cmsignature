# Singularity definition for CellBender (GPU) on an HPC/SLURM cluster.
#
# EASIEST PATH (recommended): skip building, just pull the Broad image into a .sif:
#   module load singularity/3.x
#   singularity pull $PROJ/env/cellbender.sif \
#       docker://us.gcr.io/broad-dsde-methods/cellbender:0.3.0
#
# Pull on a node with internet egress (login or data-mover). Then run with --nv for GPU:
#   singularity exec --nv -B $SCRATCH,$PROJ $PROJ/env/cellbender.sif \
#       cellbender remove-background --cuda --input ... --output ...
#
# This .def is only needed if you must build a custom image (e.g. pin a different
# CellBender/CUDA combo). Build requires a build node / --fakeroot or remote builder:
#   singularity build --fakeroot $PROJ/env/cellbender.sif env/cellbender.def

Bootstrap: docker
From: nvidia/cuda:11.8.0-cudnn8-runtime-ubuntu22.04

%post
    apt-get update && apt-get install -y --no-install-recommends \
        python3 python3-pip git && rm -rf /var/lib/apt/lists/*
    pip3 install --no-cache-dir torch==2.0.1 --index-url https://download.pytorch.org/whl/cu118
    pip3 install --no-cache-dir cellbender==0.3.0

%environment
    export LC_ALL=C

%runscript
    exec cellbender "$@"

%labels
    Pipeline cs-cmsignature
    Component CellBender-GPU
